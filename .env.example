# Copiar a .env y completar. Nunca commitear .env con valores reales (ver AGENTS.md §6).

NODE_ENV=development

# --- Despliegue (ver deploy.yml y docs/deployment.md) ---
DEPLOY_MODE=native

# --- Backend ---
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000
# Puerto 5433 porque 5432 puede estar ocupado por un PostgreSQL nativo del host
# (ver docker-compose.yml, POSTGRES_PORT). Ajustar si su entorno usa otro puerto.
DATABASE_URL=postgresql://vibe_coding:vibe_coding@localhost:5433/vibe_coding_dev
JWT_SECRET=change-me-in-dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend ---
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# --- IA (ver docs/ai.md) ---
# AI_PROVIDER=mock habilita MockAIAdapter sin consumir servicios externos (valor por defecto en dev/test).
AI_PROVIDER=mock
AI_API_KEY=

# --- Almacenamiento de archivos (ver docs/architecture.md §3, StoragePort) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/uploads
# STORAGE_MINIO_ENDPOINT=
# STORAGE_MINIO_ACCESS_KEY=
# STORAGE_MINIO_SECRET_KEY=
# STORAGE_MINIO_BUCKET=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
