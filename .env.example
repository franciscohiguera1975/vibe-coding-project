# Copiar a .env y completar. Nunca commitear .env con valores reales (ver AGENTS.md §6).

NODE_ENV=development

# --- Despliegue (ver deploy.yml y docs/deployment.md) ---
DEPLOY_MODE=native
# SEED_ON_START=true hace que el contenedor backend ejecute el seed idempotente
# al arrancar (solo aplica en DEPLOY_MODE=docker).
SEED_ON_START=true
# Dominio de Moodle permitido para embeber /practices/{slug}/embed en un <iframe>
# (ver docs/moodle-integration.md). Vacio = solo se permite el propio origen.
MOODLE_ORIGIN=

# --- Backend ---
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000
# Puerto 5433 porque 5432 puede estar ocupado por un PostgreSQL nativo del host
# (ver docker-compose.yml, POSTGRES_PORT). Ajustar si su entorno usa otro puerto.
DATABASE_URL=postgresql://vibe_coding:vibe_coding@localhost:5433/vibe_coding_dev
POSTGRES_USER=vibe_coding
POSTGRES_PASSWORD=vibe_coding
POSTGRES_DB=vibe_coding_dev
POSTGRES_PORT=5433
JWT_SECRET=change-me-in-dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# --- Frontend ---
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# --- IA (ver docs/ai.md) ---
# AI_PROVIDER=mock habilita MockAIAdapter sin consumir servicios externos (valor por defecto en dev/test).
AI_PROVIDER=mock
AI_API_KEY=

# --- Narracion TTS (ver docs/ai.md) ---
# NARRATION_PROVIDER=mock habilita MockNarrationAdapter sin consumir servicios
# externos (valor por defecto en dev/test, igual que AI_PROVIDER=mock). Cambiar a
# "elevenlabs" y completar ELEVENLABS_API_KEY solo en un .env local, nunca commitear
# la clave real.
NARRATION_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- RAG de validacion de silabos (ver docs/saturdays_ai/00-plan.md) ---
# *_PROVIDER=mock habilita los adaptadores mock sin consumir servicios externos
# (valor por defecto en dev/test). El proveedor real es un vLLM + TEI corridos en
# el HPC de CEDIA, tunelados al VPS via SSH inverso (ver docs/saturdays_ai/02-hpc-pasos.md)
# — RAG_BASE_URL/EMBEDDING_BASE_URL apuntan entonces a localhost:<puerto tunelado>.
# GitHub Models (u otro endpoint compatible con OpenAI) sirve de respaldo:
# RAG_LLM_PROVIDER=openai_compatible, RAG_BASE_URL=https://models.github.ai/inference,
# RAG_API_KEY=<token>.
RAG_LLM_PROVIDER=mock
RAG_BASE_URL=
RAG_API_KEY=
RAG_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Chunks+embeddings de la normativa: tabla LanceDB embebida co-ubicada con el
# backend (no Postgres, no el HPC — decision pedagogica, ver
# docs/saturdays_ai/00-plan.md §5).
LANCEDB_PATH=./storage/lancedb

# --- Almacenamiento de archivos (ver docs/architecture.md §3, StoragePort) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/uploads
# STORAGE_MINIO_ENDPOINT=
# STORAGE_MINIO_ACCESS_KEY=
# STORAGE_MINIO_SECRET_KEY=
# STORAGE_MINIO_BUCKET=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email / recuperacion de contraseña (ver docs/authentication.md) ---
# EMAIL_PROVIDER=console escribe el enlace de restablecimiento al log del backend en
# vez de enviarlo (valor por defecto en dev/test, no requiere credenciales).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vibecoding-platform.dev
SMTP_USE_TLS=true
