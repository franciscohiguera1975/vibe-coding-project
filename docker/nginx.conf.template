# Plantilla procesada por el entrypoint oficial de la imagen nginx:alpine
# (envsubst sobre /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf),
# asi MOODLE_ORIGIN se puede ajustar por variable de entorno sin reconstruir la
# imagen. Ver docs/moodle-integration.md.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Permite enmarcar /practices/*/embed desde el dominio de Moodle (ver
    # docs/moodle-integration.md). 'self' se mantiene para navegacion directa.
    add_header Content-Security-Policy "frame-ancestors 'self' ${MOODLE_ORIGIN}" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|woff2?)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
}
