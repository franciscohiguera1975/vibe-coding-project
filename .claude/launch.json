{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "apps/frontend"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "apps/backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--port", "3000", "--app-dir", "apps/backend"],
      "port": 3000
    }
  ]
}
